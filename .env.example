# Copy to .env.local and fill in. Never commit real values.
# Source of truth + validation: lib/env.ts

# --- Required ---
NEYNAR_API_KEY=
FARCASTER_DOMAIN=                 # must exactly match your signed manifest domain
DEPLOYER_PK=                      # funded xDAI EOA, 0x + 64 hex. Pays Safe deploy gas. NEVER COMMIT.

# --- Inviter Safe (holds your Circles invite quota) ---
INVITER_SAFE_ADDRESS=             # your inviter Safe (overrides the project default)
# INVITER_OWNER_PK=               # owner key of the inviter Safe; defaults to DEPLOYER_PK

# --- App ---
NEXT_PUBLIC_APP_URL=              # full prod URL, e.g. https://your-app.vercel.app

# --- RPCs (optional; public defaults in lib/env.ts) ---
# GNOSIS_RPC_URL=
# CIRCLES_RPC_URL=
# ETH_RPC_URL=
# BASE_RPC_URL=

# --- Anti-spam gate (optional) ---
# ONBOARD_GATE=off                # off | powerBadge | mutual | powerBadgeOrMutual | powerBadgeAndMutual
# ONBOARD_ALLOWLIST_FIDS=         # comma-separated fids that always bypass the gate
# DEBUG_VIEWER_FID=               # operator's own fid; required for mutual gating + richer debug
# ONBOARD_DEBUG=                  # set true to include the verbose debug payload in prod

# --- Gasless-deploy spike only (scripts/spike-claim.ts); NOT used by the onboard flow ---
# PIMLICO_API_KEY=
# PIMLICO_SPONSORSHIP_POLICY_ID=
