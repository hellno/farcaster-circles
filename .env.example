# ---- Farcaster ----
# Free tier from https://dev.neynar.com
NEYNAR_API_KEY=

# The final production domain your manifest is signed for, no scheme.
# e.g. farcaster-circles.vercel.app
FARCASTER_DOMAIN=

# Optional — only if you mint your own HMAC tokens. Quick Auth alone does not need this.
QUICK_AUTH_SECRET=

# ---- Vercel KV ----
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ---- App ----
# Public URL of the deployed app, no trailing slash.
# e.g. https://farcaster-circles.vercel.app
NEXT_PUBLIC_APP_URL=

# ---- Circles ----
# The single multi-claim magic link generated in the Circles Invitation Manager
# against your Circles avatar. All recipients land here; the manager allocates
# one redemption per claim. Get this from https://app.aboutcircles.com.
# Must be of the form https://circles.gnosis.io/invitation/{code}
CIRCLES_MAGIC_LINK=

# ---- Spike (Phase A — temporary, used only by scripts/spike-claim.ts) ----
# Distribution session slug created at https://circles.gnosis.io/admin/invitations-manager
CIRCLES_REFERRAL_SLUG=
# Pimlico API key from https://dashboard.pimlico.io — used for ERC-4337 bundler
# AND verifying paymaster on Gnosis Chain (chainId 100).
PIMLICO_API_KEY=
# Sponsorship policy ID (sp_...) from Pimlico dashboard → Sponsorship Policies.
# Policy must allow Gnosis Chain (100) and the Safe 4337 module sender.
PIMLICO_SPONSORSHIP_POLICY_ID=
# Gnosis Chain RPC. Default https://rpc.gnosischain.com if unset
GNOSIS_RPC_URL=
# Throwaway funded EOA for diagnostic / Branch 3 fallback (a few cents of xDAI)
SPIKE_THROWAWAY_PK=
